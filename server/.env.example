# Copy to .env for local development
MONGO_URI=mongodb://127.0.0.1:27017/devconnector
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins (no trailing slash, no spaces)
CLIENT_ORIGIN=http://localhost:5173
# Optional: raises the GitHub API rate limit for the "latest repos" feature
GITHUB_TOKEN=
PORT=5000
